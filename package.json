{
  "name": "conduit",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*"
    ],
    "catalogs": {
      "effect": {
        "@effect/platform-node": "^4.0.0-beta.98",
        "effect": "^4.0.0-beta.98",
        "@effect/sql-sqlite-node": "^4.0.0-beta.98"
      },
      "types": {
        "@types/node": "^26.1.1"
      }
    },
    "catalog": {
      "typescript": "^7.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "check": "turbo run quality:check",
    "dev": "turbo run dev",
    "doctor": "turbo run quality:doctor",
    "fix": "turbo run quality:fix",
    "format": "turbo run quality:format",
    "format:check": "turbo run quality:format:check",
    "format:fix": "turbo run quality:format:fix",
    "lint": "turbo run quality:lint",
    "lint:fix": "turbo run quality:lint:fix",
    "quality:check": "oxfmt --check . && oxlint .",
    "quality:doctor": "ultracite doctor",
    "quality:fix": "oxfmt --write . && oxlint --fix .",
    "quality:format": "oxfmt --write .",
    "quality:format:check": "oxfmt --check .",
    "quality:format:fix": "oxfmt --write .",
    "quality:lint": "oxlint .",
    "quality:lint:fix": "oxlint --fix .",
    "test": "turbo run test"
  },
  "devDependencies": {
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "^2.10.5",
    "ultracite": "7.9.4"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.4.11",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "nub@0.4.11",
  "patchedDependencies": {
    "@effect/vitest@4.0.0-beta.98": "patches/@effect+vitest@4.0.0-beta.98.patch"
  }
}
